<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".RegisterPasswordActivity">

    <!-- 상단 그레이 구분선 -->
    <View
        android:id="@+id/topGranyDivider"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="80dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@color/gray200"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 상단 퍼플 구분선 -->
    <View
        android:id="@+id/topDivider"
        android:layout_width="125dp"
        android:layout_height="3dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="200dp"
        android:layout_marginStart="125dp"
        android:background="@color/main"
        app:layout_constraintStart_toStartOf="@+id/topGranyDivider"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 비밀번호를 입력해주세요 텍스트 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="비밀번호를 입력해주세요."
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topDivider" />

    <!-- 비밀번호 입력 필드 -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/rounded_edit_text"
        android:hint="abxcdje@"
        android:inputType="textPassword"
        android:padding="16dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <!-- 비밀번호 요구사항 -->
    <LinearLayout
        android:id="@+id/llPasswordRequirements"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etPassword">

        <!-- 8자리 이상 -->
        <TextView
            android:id="@+id/tvReqLength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="8자리 이상"
            android:textColor="#C89AFF"
            android:textSize="12sp" />

        <!-- 숫자 -->
        <TextView
            android:id="@+id/tvReqNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="숫자"
            android:textColor="#C89AFF"
            android:textSize="12sp" />

        <!-- 영문 -->
        <TextView
            android:id="@+id/tvReqAlphabet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="영문"
            android:textColor="#C89AFF"
            android:textSize="12sp" />

        <!-- 특수문자 -->
        <TextView
            android:id="@+id/tvReqSpecialChar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="특수문자"
            android:textColor="#C89AFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 상태 메시지 (오류 상태) -->
    <TextView
        android:id="@+id/tvStatusError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="비밀번호가 요구사항을 충족하지 않습니다."
        android:textColor="#FF0000"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llPasswordRequirements" />

    <!-- 다음 버튼 (활성화) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#C89AFF"
        android:paddingVertical="12dp"
        android:text="다음"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 다음 버튼 (비활성화) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNextDisabled"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#E0E0E0"
        android:paddingVertical="12dp"
        android:text="다음"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="gone"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>