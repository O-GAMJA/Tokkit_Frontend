<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 뒤로가기 버튼 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 안내 문구 -->
    <TextView
        android:id="@+id/tv_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="대화에 참고할 자료를 첨부해 주세요"
        android:textSize="20sp"
        android:textColor="#222222"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 사진 첨부 버튼 -->
    <ImageButton
        android:id="@+id/btn_attach_photo"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/attach_photo"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_instruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </ImageButton>

    <!-- 파일 첨부 버튼 -->
    <ImageButton
        android:id="@+id/btn_attach_file"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/attach_file"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_attach_photo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </ImageButton>

    <!-- 건너뛰기 버튼 -->
    <TextView
        android:id="@+id/btn_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="건너뛰기 →"
        android:textSize="20sp"
        android:textColor="#888888"
        android:layout_marginBottom="70dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
