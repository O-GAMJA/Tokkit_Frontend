<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".RegisterIdActivity">

    <!-- 상단 그레이 구분선 -->
    <View
        android:id="@+id/topGranyDivider"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="80dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@color/gray200"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 상단 퍼플 구분선 -->
    <View
        android:id="@+id/topDivider"
        android:layout_width="125dp"
        android:layout_height="3dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="200dp"
        android:background="@color/main"
        app:layout_constraintStart_toStartOf="@+id/topGranyDivider"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 아이디를 입력해주세요 텍스트 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="아이디를 입력해주세요."
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topDivider" />

    <!-- 아이디 입력 필드 -->
    <EditText
        android:id="@+id/etId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/rounded_edit_text"
        android:hint="abxcdje"
        android:inputType="text"
        android:padding="16dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <ImageView
        android:id="@+id/ivAlert"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_alert"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/etId"
        app:layout_constraintTop_toTopOf="@id/etId"
        app:layout_constraintBottom_toBottomOf="@+id/etId"
        android:layout_marginEnd="15dp" />

    <!-- 상태 메시지 (사용 가능 상태) -->
    <TextView
        android:id="@+id/tvStatusAvailable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:text="사용가능한 아이디 입니다."
        android:textColor="#0047FF"
        android:textSize="12sp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etId" />

    <!-- 상태 메시지 (오류 상태) -->
    <TextView
        android:id="@+id/tvStatusError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:text="이미 존재하는 아이디 입니다."
        android:textColor="#FF0000"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etId" />

    <!-- 글자 수 카운터 -->
    <TextView
        android:id="@+id/tvCharCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="5~30자의 숫자,영문"
        android:textColor="#808080"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etId"
        android:layout_marginTop="10dp"/>

    <!-- 다음 버튼 (사용 가능 상태) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#C89AFF"
        android:paddingVertical="12dp"
        android:text="다음"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 다음 버튼 (비활성화 상태) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNextDisabled"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#E0E0E0"
        android:paddingVertical="12dp"
        android:text="다음"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="gone"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>