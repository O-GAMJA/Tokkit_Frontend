<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:padding="8dp">

    <!-- 봇 메시지 레이아웃 - 이미지 추가 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/left_chat_layout"
        android:orientation="horizontal"
        android:layout_marginEnd="60dp"
        android:gravity="start|center_vertical">

        <!-- 봇 이미지 -->
        <ImageView
            android:id="@+id/bot_image"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_bot"
            android:contentDescription="봇 이미지" />

        <!-- 봇 메시지 버블 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bot_response"
            android:padding="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bot_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 사용자 메시지 레이아웃 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/user_input"
        android:layout_alignParentEnd="true"
        android:padding="8dp"
        android:layout_marginStart="60dp"
        android:id="@+id/right_chat_layout"
        tools:ignore="RelativeOverlap">

        <TextView
            android:id="@+id/user_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="2dp"
            android:paddingTop="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            android:textSize="20sp" />
    </LinearLayout>
</RelativeLayout>